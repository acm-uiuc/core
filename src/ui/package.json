{
  "name": "infra-core-ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "VITE_RUN_ENVIRONMENT=local-dev vite",
    "dev:aws": "cross-env VITE_RUN_ENVIRONMENT=dev vite",
    "build": "tsc && vite build",
    "preview": "cross-env VITE_RUN_ENVIRONMENT=local-dev yarn build && cross-env VITE_RUN_ENVIRONMENT=local-dev serve -l 5173 -s ../../dist_ui/",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --check \"**/*.{ts,tsx}\"",
    "format:write": "oxfmt --write \"**/*.{ts,tsx}\"",
    "vitest": "vitest run",
    "vitest:watch": "vitest",
    "test": "yarn run typecheck && yarn run format && yarn run lint && yarn run vitest && yarn run build",
    "test:unit": "yarn run vitest"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.27.0",
    "@azure/msal-react": "^3.0.23",
    "@mantine/core": "^9.6.3",
    "@mantine/dates": "^9.6.3",
    "@mantine/dropzone": "^9.6.3",
    "@mantine/form": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@tabler/icons-react": "^3.48.0",
    "@ungap/with-resolvers": "^0.1.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.4",
    "dotenv-cli": "^11.0.0",
    "html5-qrcode": "^2.3.8",
    "jsqr": "^1.4.0",
    "mantine-form-zod-resolver": "^1.3.0",
    "pdfjs-dist": "^6.3.289",
    "pluralize": "^8.0.0",
    "react": "^19.3.0",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.3",
    "react-pdf": "^11.0.0",
    "react-pdftotext": "^1.4.0",
    "react-qr-reader": "^3.0.0-beta-1",
    "react-router-dom": "^7.18.4",
    "spark-md5": "^3.0.2",
    "zod": "^4.6.5",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-react": "^6.0.2",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.18",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prop-types": "^15.8.1",
    "stylelint": "^17.12.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.0.16",
    "yarn-upgrade-all": "^0.8.1"
  },
  "resolutions": {
    "pdfjs-dist": "4.5.136"
  }
}
